--- a/settings.py
+++ b/settings.py
@@ -1,4 +1,31 @@
 def merge_settings(defaults, overrides):
-    result = defaults.copy()
-    result.update(overrides)
+    """Recursively merge dictionaries; other values override defaults.
+
+    - Dict values are recursively merged
+    - Other values (None, lists, primitives) are replaced by override
+    - Returns an independent deep copy of the result
+    - Neither input is modified during merging
+    """
+
+    # Use empty dict and collect all keys; don't mutate inputs
+    result = {}
+    all_keys = set(defaults.keys()) | set(overrides.keys())
+
+    for key in all_keys:
+        if key in defaults and key in overrides:
+            # Both have the key - check if they're dicts for recursive merge
+            defaults_value = defaults[key]
+            overrides_value = overrides[key]
+
+            if isinstance(defaults_value, dict) and isinstance(overrides_value, dict):
+                # Recursive merge for nested dicts
+                result[key] = merge_settings(defaults_value, overrides_value)
+            else:
+                # Override value replaces (including None and lists)
+                result[key] = overrides_value
+        elif key in defaults:
+            result[key] = defaults[key]
+        else:
+            result[key] = overrides[key]
+
     return result
