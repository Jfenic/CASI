--- a/config.py
+++ b/config.py
@@ -1,4 +1,20 @@
 def parse_bool(value, default=False):
     if value is None:
         return default
-    return bool(value)
+
+    # Check if already a boolean
+    if isinstance(value, bool):
+        return value
+
+    # Handle string values - strip and case-insensitive matching
+    if isinstance(value, str):
+        s = value.strip().lower()
+        if s in ('true', '1', 'yes', 'on'):
+            return True
+        elif s in ('false', '0', 'no', 'off'):
+            return False
+        else:
+            raise ValueError(f"Invalid boolean string: {value!r}")
+
+    # Non-string, non-bool values raise TypeError
+    raise TypeError(f"Expected bool or string, got {type(value).__name__}")
